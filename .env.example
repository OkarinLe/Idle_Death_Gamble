# Copy this file to .env.local and fill in the values. NEVER commit .env.local.
# Names only here, no real values.

# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
# PUBLISHABLE key (sb_publishable_...) or the legacy anon key. NEVER a secret key here: it goes to browsers.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret service-role key. Server code and scripts only.
SUPABASE_SERVICE_ROLE_KEY=

# AI: "databricks" (default) or "claude" (backup)
AI_PROVIDER=databricks
DATABRICKS_HOST=your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_MODEL=databricks-llama-4-maverick
ANTHROPIC_API_KEY=

# ANS (Agent Name Service). demo = built-in simulated registry; live = real DNS + GoDaddy transparency log.
ANS_MODE=demo
ANS_DOMAIN=your-domain.com
# live mode only: hosts allowed to serve ANS badges (comma separated)
ANS_TRUSTED_LOG_HOSTS=
